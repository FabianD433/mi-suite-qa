DATASCEND_BASE_URL=https://qa2.datascend.net
DATASCEND_EMAIL=
DATASCEND_PASSWORD=

# Opcional – TC1580 (usuario nuevo sin preferencias guardadas). Si se omite, ese test se salta.
DATASCEND_NEW_USER_EMAIL=
DATASCEND_NEW_USER_PASSWORD=

# Opcional – entidad con tabla/filtros para TC1585/TC1586 (por defecto: Employees en qa2)
# DATASCEND_REPORT_PATH=/dashboard/entity/bca60f26-322d-4fb8-8bbb-8c05fbad033a

# Opcional – ver el navegador mientras corren las pruebas
# HEADLESS=false

# Opcional – Notifications: ejecutar Dismiss/Delete/Dismiss All/Delete All contra el backend REAL.
# Por defecto (false) esas peticiones se interceptan en el navegador. ¡Delete All borra TODAS las notificaciones!
# NOTIFICATIONS_DESTRUCTIVE=true

# Opcional – Notifications TC1353/TC1431: segundo usuario que modifica/borra registros de la cuenta principal.
# Si se omite, esos casos se saltan.
DATASCEND_USER_B_EMAIL=
DATASCEND_USER_B_PASSWORD=
